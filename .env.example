# Token JWT da API aberta do Supremo CRM (obtido no proprio Supremo CRM da imobiliaria).
# NUNCA versione o token real. Copie este arquivo para .env e cole o token la.
SUPREMO_TOKEN=cole_seu_token_aqui

# Porta do servidor (opcional, padrao 8787)
PORT=8787

# Minutos de cache dos dados agregados (opcional, padrao 15)
CACHE_TTL_MIN=15
